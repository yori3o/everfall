{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A client-side mod that adds configurable seasonal particles to GUI screens.",
  "authors": [
    "Yori3o"
  ],
  "contact": {
    "homepage": "https://github.com/yori3o/everfall",
    "sources": "https://github.com/yori3o/everfall"
  },
  "license": "MIT",
  "icon": "assets/everfall/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yori3o.everfall.platform.fabric.EverfallFabricClient"
    ],
    "modmenu": [
      "com.yori3o.everfall.platform.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "everfall.mixins.json"
  ],
  "accessWidener": "template.ct",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "yet_another_config_lib_v3": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
